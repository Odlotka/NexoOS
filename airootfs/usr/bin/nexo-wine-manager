#!/usr/bin/env bash
# ==============================================================================
# NexoOS Windows Binary & Wine Management Suite (nexo-wine-manager)
# Process control, DXVK shader cache clearing, prefixes & Bubblewrap sandbox
# ==============================================================================

set -euo pipefail

CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
RESET="\033[0m"

function kill_wineserver() {
    echo -e "${YELLOW}[*] Terminating all active Wine processes and servers...${RESET}"
    wineserver -k || true
    pkill -9 -f "wine" || true
    notify-send "NexoOS Wine Manager" "All Windows processes cleanly terminated."
    echo -e "${GREEN}[✓] Wineserver killed successfully.${RESET}"
}

function clear_dxvk_cache() {
    echo -e "${CYAN}[*] Flushing DXVK and VKD3D shader caches...${RESET}"
    rm -rf ~/.local/share/dxvk-cache/* 2>/dev/null || true
    rm -rf ~/.cache/mesa_shader_cache/* 2>/dev/null || true
    rm -rf ~/.nv/GLCache/* 2>/dev/null || true
    notify-send "NexoOS Wine Manager" "DXVK shader caches cleared."
    echo -e "${GREEN}[✓] Shaders purged.${RESET}"
}

function run_sandboxed() {
    local target="${1:-}"
    if [[ -z "${target}" || ! -f "${target}" ]]; then
        echo -e "${RED}[ERROR] No executable specified for sandboxed execution.${RESET}"
        exit 1
    fi

    echo -e "${YELLOW}[!] Launching in Bubblewrap isolated sandbox (Restricted SSH/GPG/Root)...${RESET}"
    notify-send "NexoOS Sandbox" "Launching in isolated Bubblewrap container..."

    bwrap \
        --ro-bind /usr /usr \
        --ro-bind /lib /lib \
        --ro-bind /lib64 /lib64 \
        --ro-bind /bin /bin \
        --ro-bind /sbin /sbin \
        --ro-bind /etc /etc \
        --dev /dev \
        --proc /proc \
        --tmpfs /tmp \
        --tmpfs /run \
        --dir /tmp/sandbox-home \
        --bind /tmp/sandbox-home "${HOME}" \
        --unshare-all \
        --share-net \
        --die-with-parent \
        wine "${target}"
}

# GUI Menu Dispatcher if no arguments
if [[ $# -eq 0 ]]; then
    if [[ -n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}" ]]; then
        CHOICE=$(zenity --list --radiolist \
            --title="NexoOS Wine & Windows Compatibility Manager" \
            --column="Select" --column="Action" \
            TRUE "Kill Frozen Windows Applications (wineserver -k)" \
            FALSE "Purge DXVK / Mesa Shader Caches" \
            FALSE "Run Executable in Isolated Bubblewrap Sandbox" \
            --width=520 --height=220) || exit 0

        case "${CHOICE}" in
            "Kill Frozen"*)
                kill_wineserver
                ;;
            "Purge DXVK"*)
                clear_dxvk_cache
                ;;
            "Run Executable"*)
                TARGET=$(zenity --file-selection --title="Select Windows Executable (.exe, .msi)" \
                    --file-filter="Windows Executables | *.exe *.msi") || exit 0
                run_sandboxed "${TARGET}"
                ;;
        esac
    fi
    exit 0
fi

# CLI arguments
case "${1:-}" in
    kill)
        kill_wineserver
        ;;
    clearcache)
        clear_dxvk_cache
        ;;
    sandbox)
        shift
        run_sandboxed "$@"
        ;;
    *)
        echo "Usage: nexo-wine-manager [kill|clearcache|sandbox <path_to_exe>]"
        ;;
esac
