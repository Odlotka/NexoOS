#!/usr/bin/env bash
# ==============================================================================
# NexoOS Factory Reset & Btrfs Rollback Engine (nexo-reset)
# Complete with 3-Mode Operations, Safety Verification & Zenity GUI Wizard
# ==============================================================================

set -euo pipefail

CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
RESET="\033[0m"

function check_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}[!] Escalating to administrator privileges...${RESET}"
        exec sudo "$0" "$@"
    fi
}

# ------------------------------------------------------------------------------
# Mode 1: Complete Factory Wipe
# ------------------------------------------------------------------------------
function do_mode1_factory_wipe() {
    echo -e "${RED}[!] Commencing Mode 1: COMPLETE FACTORY WIPE...${RESET}"

    ROOT_DEV="$(findmnt -n -o SOURCE / | sed 's/\[.*\]//')"
    TMP_MNT="/tmp/nexo_rollback"
    mkdir -p "${TMP_MNT}"
    mount -o subvolid=5 "${ROOT_DEV}" "${TMP_MNT}"

    if [[ ! -d "${TMP_MNT}/@factory-base" ]]; then
        echo -e "${RED}[ERROR] Immutable @factory-base snapshot not found! Cannot perform atomic restore.${RESET}"
        umount "${TMP_MNT}" || true
        exit 1
    fi

    echo -e "${YELLOW}[*] Archiving current root to @broken_$(date +%s)...${RESET}"
    mv "${TMP_MNT}/@" "${TMP_MNT}/@broken_$(date +%s)"
    
    echo -e "${GREEN}[*] Recreating clean root from @factory-base snapshot...${RESET}"
    btrfs subvolume snapshot "${TMP_MNT}/@factory-base" "${TMP_MNT}/@"

    echo -e "${YELLOW}[*] Re-initializing @home user profile hierarchy from /etc/skel/...${RESET}"
    if [[ -d "${TMP_MNT}/@home" ]]; then
        # Find usernames
        for udir in "${TMP_MNT}/@home"/*; do
            if [[ -d "${udir}" ]]; then
                local user
                user="$(basename "${udir}")"
                rm -rf "${udir}"
                mkdir -p "${udir}"
                cp -rT /etc/skel "${udir}"
                chown -R "${user}:${user}" "${udir}" || true
            fi
        done
    fi

    umount "${TMP_MNT}"
    rmdir "${TMP_MNT}"

    echo -e "${GREEN}[✓] Complete Factory Wipe finalized! System must reboot immediately.${RESET}"
}

# ------------------------------------------------------------------------------
# Mode 2: Keep Personal Documents (App & Config Reset)
# ------------------------------------------------------------------------------
function do_mode2_keep_docs() {
    echo -e "${YELLOW}[!] Commencing Mode 2: APP & CONFIG RESET (Keep Documents)...${RESET}"

    ROOT_DEV="$(findmnt -n -o SOURCE / | sed 's/\[.*\]//')"
    TMP_MNT="/tmp/nexo_rollback"
    mkdir -p "${TMP_MNT}"
    mount -o subvolid=5 "${ROOT_DEV}" "${TMP_MNT}"

    if [[ -d "${TMP_MNT}/@factory-base" ]]; then
        echo -e "${GREEN}[*] Rolling back system root @ to @factory-base...${RESET}"
        mv "${TMP_MNT}/@" "${TMP_MNT}/@archived_$(date +%s)"
        btrfs subvolume snapshot "${TMP_MNT}/@factory-base" "${TMP_MNT}/@"
    fi

    echo -e "${CYAN}[*] Preserving personal files while restoring default dotfiles...${RESET}"
    if [[ -d "${TMP_MNT}/@home" ]]; then
        for udir in "${TMP_MNT}/@home"/*; do
            if [[ -d "${udir}" ]]; then
                local user
                user="$(basename "${udir}")"
                # Preserve Documents, Downloads, Pictures, Videos, Desktop
                mkdir -p "/tmp/preserved_${user}"
                for d in Desktop Documents Downloads Pictures Videos; do
                    if [[ -d "${udir}/${d}" ]]; then
                        mv "${udir}/${d}" "/tmp/preserved_${user}/"
                    fi
                done

                # Wipe configs and caches
                rm -rf "${udir}/.config" "${udir}/.local" "${udir}/.cache" "${udir}/.wine"

                # Restore skel templates
                cp -rT /etc/skel "${udir}"

                # Restore personal folders
                for d in Desktop Documents Downloads Pictures Videos; do
                    if [[ -d "/tmp/preserved_${user}/${d}" ]]; then
                        rm -rf "${udir}/${d}"
                        mv "/tmp/preserved_${user}/${d}" "${udir}/"
                    fi
                done
                rm -rf "/tmp/preserved_${user}"
                chown -R "${user}:${user}" "${udir}" || true
            fi
        done
    fi

    umount "${TMP_MNT}"
    rmdir "${TMP_MNT}"
    echo -e "${GREEN}[✓] App & Config Reset complete. Documents preserved!${RESET}"
}

# ------------------------------------------------------------------------------
# Mode 3: Quick Privacy & Traces Purge
# ------------------------------------------------------------------------------
function do_mode3_privacy_purge() {
    echo -e "${CYAN}[*] Commencing Mode 3: PRIVACY & TRACES PURGE...${RESET}"
    
    echo "[*] Vacuuming systemd journal logs to 1 second..."
    journalctl --vacuum-time=1s || true

    echo "[*] Purging shell histories and user caches..."
    for home_dir in /home/*; do
        if [[ -d "${home_dir}" ]]; then
            rm -f "${home_dir}/.bash_history" "${home_dir}/.zsh_history"
            rm -rf "${home_dir}/.cache"/*
            rm -rf "${home_dir}/.wine"
        fi
    done
    rm -f /root/.bash_history /root/.zsh_history

    sync
    echo 3 > /proc/sys/vm/drop_caches
    echo -e "${GREEN}[✓] Privacy and temporary traces purged.${RESET}"
}

# ------------------------------------------------------------------------------
# GUI Wizard (Zenity Interface)
# ------------------------------------------------------------------------------
function run_gui() {
    local choice
    choice=$(zenity --list --radiolist \
        --title="NexoOS Factory Reset & Rollback Wizard" \
        --text="Select restoration mode:" \
        --column="Select" --column="Mode" --column="Description" \
        TRUE "Mode 1" "Complete Factory Wipe (Rollback root and wipe user profile)" \
        FALSE "Mode 2" "Keep Personal Documents (Rollback root, preserve user files, reset configs)" \
        FALSE "Mode 3" "Quick Privacy & Traces Purge (Clear journal logs, history, and caches)" \
        --width=680 --height=320) || exit 0

    local confirm
    confirm=$(zenity --entry \
        --title="Safety Verification Required" \
        --text="WARNING: This action modifies system partitions.\nType 'CONFIRM' in capital letters to proceed:" \
        --width=450) || exit 0

    if [[ "${confirm}" != "CONFIRM" ]]; then
        zenity --error --text="Verification failed. Operation cancelled."
        exit 1
    fi

    case "${choice}" in
        "Mode 1")
            check_root
            do_mode1_factory_wipe
            zenity --info --text="Complete Factory Wipe successful! The system will now reboot."
            reboot
            ;;
        "Mode 2")
            check_root
            do_mode2_keep_docs
            zenity --info --text="App & Config Reset successful! Please log out or reboot."
            ;;
        "Mode 3")
            check_root
            do_mode3_privacy_purge
            zenity --info --text="Privacy & Traces purge completed successfully."
            ;;
    esac
}

# Entrypoint: Check if GUI or CLI
if [[ "${1:-}" == "--cli" ]]; then
    check_root
    echo -e "${CYAN}=== NexoOS Factory Reset CLI ===${RESET}"
    echo "1) Complete Factory Wipe"
    echo "2) Keep Personal Documents (App & Config Reset)"
    echo "3) Quick Privacy & Traces Purge"
    read -rp "Select mode [1-3]: " opt
    read -rp "Type 'CONFIRM' to execute: " conf
    if [[ "${conf}" != "CONFIRM" ]]; then
        echo -e "${RED}[ERROR] Aborted.${RESET}"
        exit 1
    fi
    case "${opt}" in
        1) do_mode1_factory_wipe ;;
        2) do_mode2_keep_docs ;;
        3) do_mode3_privacy_purge ;;
        *) echo "Invalid option." ;;
    esac
else
    if [[ -n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}" ]]; then
        run_gui
    else
        check_root
        exec "$0" --cli
    fi
fi
