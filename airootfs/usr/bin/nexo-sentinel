#!/usr/bin/env bash
# ==============================================================================
# NexoOS Sentinel AI - Autonomous Threat Hunter & Antivirus Engine
# Deep heuristic file inspection, risk scoring (0-100%), sandbox & gatekeeper
# ==============================================================================

set -euo pipefail

CONFIG_DIR="${HOME}/.config/nexo/sentinel"
QUARANTINE_DIR="${CONFIG_DIR}/quarantine"
LOG_FILE="${CONFIG_DIR}/threats.log"

mkdir -p "${CONFIG_DIR}" "${QUARANTINE_DIR}"

TARGET_FILE="${1:-}"

if [[ "${TARGET_FILE}" == "--gatekeeper" ]]; then
    TARGET_FILE="${2:-}"
    IS_GATEKEEPER=true
else
    IS_GATEKEEPER=false
fi

if [[ -z "${TARGET_FILE}" ]]; then
    TARGET_FILE=$(zenity --file-selection --title="Nexo Sentinel - Wybierz plik do przeskanowania") || exit 0
fi

if [[ ! -f "${TARGET_FILE}" ]]; then
    zenity --error --text="Plik nie istnieje: ${TARGET_FILE}"
    exit 1
fi

FILE_NAME=$(basename "${TARGET_FILE}")
FILE_SIZE=$(du -h "${TARGET_FILE}" | awk '{print $1}')
FILE_MIME=$(file -b --mime-type "${TARGET_FILE}" 2>/dev/null || echo "unknown")

function analyze_threat() {
    local score=0
    local threat_vectors=()
    local evidence=()

    # 1. Sprawdzenie podwójnego rozszerzenia (np. faktura.pdf.exe)
    if [[ "${FILE_NAME}" =~ \.(pdf|docx?|xlsx?|jpg|png|zip)\.(exe|sh|bin|vbs|bat|scr)$ ]]; then
        score=$((score + 40))
        threat_vectors+=("Maskowanie Rozszerzenia (Technika Dropper / Phishing)")
        evidence+=("Plik podszywa się pod dokument: ${FILE_NAME}")
    fi

    # 2. Skanowanie silnikiem ClamAV (jeśli baza jest dostępna)
    if command -v clamscan >/dev/null 2>&1; then
        local clam_out
        clam_out=$(clamscan --no-summary "${TARGET_FILE}" 2>/dev/null || true)
        if [[ "${clam_out}" =~ FOUND ]]; then
            score=95
            local sig
            sig=$(echo "${clam_out}" | awk '{print $2}')
            threat_vectors+=("Sygnatura Wirusa ClamAV: ${sig}")
            evidence+=("Wykryto znany kod złośliwego oprogramowania: ${sig}")
        fi
    fi

    # 3. Heurystyczna analiza zawartości binarnej / tekstowej (Strings Inspection)
    if [[ "${score}" -lt 95 ]]; then
        local file_strings
        file_strings=$(strings -n 6 "${TARGET_FILE}" 2>/dev/null | head -n 5000 || true)

        # A. Kradzież danych i portfeli (Stealer)
        if echo "${file_strings}" | grep -Ei -q "(wallet\.dat|Login Data|cookies\.sqlite|Web Data|tokens\.json|\.purple/accounts)"; then
            score=$((score + 35))
            threat_vectors+=("Próba Kradzieży Danych (Stealer / Credential Harvesting)")
            evidence+=("Plik odwołuje się do baz haseł przeglądarek i portfeli kryptowalut")
        fi

        # B. Odwołania do podejrzanych domen i pobierania w locie (Dropper / Downloader)
        if echo "${file_strings}" | grep -Ei -q "(curl.*\|.*(sh|bash)|wget.*\|.*(sh|bash)|powershell.*-enc|Invoke-Expression)"; then
            score=$((score + 45))
            threat_vectors+=("Zdalne Wykonywanie Kodu (Downloader / Reverse Shell)")
            evidence+=("Wykryto ukryty kod pobierający i wykonujący payload w pamięci")
        fi

        # C. Podsłuch klawiatury (Keylogger)
        if echo "${file_strings}" | grep -Ei -q "(GetAsyncKeyState|SetWindowsHookEx|xinput_state|/dev/input/event)"; then
            score=$((score + 30))
            threat_vectors+=("Przechwytywanie Klawiatury (Keylogger)")
            evidence+=("Plik zawiera instrukcje przechwytywania wciśnięć klawiszy")
        fi

        # D. Ewasja antywirusów
        if echo "${file_strings}" | grep -Ei -q "(DisableAntiSpyware|amsiInitFailed|VirtualProtect)"; then
            score=$((score + 25))
            threat_vectors+=("Omijanie Zabezpieczeń (Defense Evasion)")
            evidence+=("Wykryto próby manipulacji pamięcią i wyłączania ochrony")
        fi
    fi

    # Ogranicz wynik do 100
    if (( score > 100 )); then score=100; fi

    # Poziom ryzyka
    local risk_level="BEZPIECZNY (Czysty)"
    local risk_color="#22c55e"
    if (( score > 70 )); then
        risk_level="KRYTYCZNY (Zagrożenie Wykryte!)"
        risk_color="#ef4444"
    elif (( score > 35 )); then
        risk_level="WYSOKI (Podejrzany Kod)"
        risk_color="#f97316"
    elif (( score > 15 )); then
        risk_level="UMIARKOWANY (Wymaga Ostrożności)"
        risk_color="#eab308"
    fi

    echo "${score}|${risk_level}|${risk_color}|${threat_vectors[*]:-Brak znanych zagrożeń}|${evidence[*]:-Plik nie zawiera typowych wzorców złośliwego oprogramowania}"
}

ANALYSIS=$(analyze_threat)
SCORE=$(echo "${ANALYSIS}" | cut -d'|' -f1)
RISK_LEVEL=$(echo "${ANALYSIS}" | cut -d'|' -f2)
RISK_COLOR=$(echo "${ANALYSIS}" | cut -d'|' -f3)
VECTORS=$(echo "${ANALYSIS}" | cut -d'|' -f4)
EVIDENCE=$(echo "${ANALYSIS}" | cut -d'|' -f5)

# Zapis do dziennika zdarzeń
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Scanned: ${TARGET_FILE} | Score: ${SCORE}/100 | Risk: ${RISK_LEVEL}" >> "${LOG_FILE}"

function show_evidence_window() {
    zenity --info --title="Nexo Sentinel - Dowody Zagrożenia" \
        --text="<b>Szczegółowy Raport Heurystyczny:</b>\n\n<b>Plik:</b> ${FILE_NAME}\n<b>Wskaźnik Zagrożenia:</b> ${SCORE} / 100%\n\n<b>Wykryte wektory ataku:</b>\n• ${VECTORS}\n\n<b>Dowody i podejrzane ciągi:</b>\n• ${EVIDENCE}" \
        --width=620 --height=320
}

function run_in_sandbox() {
    notify-send -i security-high "Nexo Sentinel" "🛡️ Uruchamianie w jednorazowej piaskownicy Bubblewrap..."
    # Izolowany bwrap: odcięty katalog domowy, pamięć tymczasowa
    bwrap --ro-bind / / \
          --dev /dev \
          --proc /proc \
          --tmpfs /tmp \
          --tmpfs "${HOME}" \
          --bind "${TARGET_FILE}" "/tmp/${FILE_NAME}" \
          --unshare-all \
          --die-with-parent \
          xdg-open "/tmp/${FILE_NAME}" 2>/dev/null || wine "/tmp/${FILE_NAME}" 2>/dev/null || true
}

function quarantine_file() {
    local dest="${QUARANTINE_DIR}/${FILE_NAME}.quarantine"
    chmod -x "${TARGET_FILE}" 2>/dev/null || true
    mv "${TARGET_FILE}" "${dest}"
    notify-send -u critical -i edit-delete "Nexo Sentinel" "🗑️ Plik ${FILE_NAME} został zneutralizowany i przeniesiony do kwarantanny."
}

function allow_and_open() {
    if (( SCORE > 35 )); then
        if ! zenity --question --title="Potwierdzenie Uruchomienia" \
            --text="⚠️ <b>OSTRZEŻENIE BEZPIECZEŃSTWA:</b>\n\nTen plik uzyskał wskaźnik zagrożenia <b>${SCORE}%</b>.\nCzy na pewno chcesz go otworzyć na własne ryzyko?"; then
            return 0
        fi
    fi

    notify-send -i security-low "Nexo Sentinel" "Uruchamianie pliku: ${FILE_NAME}..."
    chmod +x "${TARGET_FILE}" 2>/dev/null || true
    if [[ "${TARGET_FILE}" =~ \.(exe|msi)$ ]]; then
        /usr/bin/nexo-exe-launcher "${TARGET_FILE}" &
    else
        xdg-open "${TARGET_FILE}" 2>/dev/null || "${TARGET_FILE}" &
    fi
}

function show_dialog() {
    local choice
    choice=$(zenity --list --radiolist \
        --title="Nexo Sentinel - Analiza Bezpieczeństwa Pliku" \
        --text="Plik: <b>${FILE_NAME}</b> (${FILE_SIZE})\nPoziom Ryzyka: <b>${RISK_LEVEL}</b> (Zagrożenie: <b>${SCORE}%</b>)\nWektor: <i>${VECTORS}</i>\n\nWybierz działanie:" \
        --column="Wybierz" --column="Akcja" --column="Opis działania" \
        TRUE "Podejrzyj co wskazuje na wirusa" "Szczegółowy podgląd podejrzanego kodu i sygnatur" \
        FALSE "Uruchom w Jednorazowej Piaskownicy" "Bezpieczna izolacja Bubblewrap (Zero dostępu do Twoich danych)" \
        FALSE "Zneutralizuj i Przenieś do Kwarantanny" "Usuwa plik i izoluje go w bezpiecznym folderze" \
        FALSE "Zezwól i Otwórz plik" "Uruchom standardowo (z potwierdzeniem)" \
        --width=720 --height=320) || exit 0

    case "${choice}" in
        *"Podejrzyj"*)
            show_evidence_window
            show_dialog
            ;;
        *"Piaskownicy"*)
            run_in_sandbox
            ;;
        *"Kwarantanny"*)
            quarantine_file
            ;;
        *"Zezwól"*)
            allow_and_open
            ;;
    esac
}

# Jeśli plik jest czysty (Score <= 15) i to Gatekeeper, otwórz od razu lub spytaj łagodnie
if (( SCORE <= 15 )) && [[ "${IS_GATEKEEPER}" == true ]]; then
    allow_and_open
else
    # Odtwórz dźwięk ostrzeżenia przy wysokim ryzyku
    if (( SCORE > 40 )); then
        command -v canberra-gtk-play >/dev/null 2>&1 && canberra-gtk-play -i dialog-warning 2>/dev/null || true
    fi
    show_dialog
fi
