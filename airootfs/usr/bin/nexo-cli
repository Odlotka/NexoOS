#!/usr/bin/env bash
# ==============================================================================
# NexoOS Master Control Utility (nexo-cli)
# Unified management for updates, stealth anonymity, boost, maintenance & diagnostics
# ==============================================================================

set -euo pipefail

CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
RESET="\033[0m"

function print_banner() {
    echo -e "${CYAN}"
    echo "    _   __                 ____  _____"
    echo "   / | / /__  _  ______   / __ \/ ___/"
    echo "  /  |/ / _ \| |/_/ __ \ / / / /\__ \ "
    echo " / /|  /  __/>  </ /_/ // /_/ /___/ / "
    echo "/_/ |_/\___/_/|_|\____(_)____//____/  "
    echo -e "NexoOS Unified Control Architecture${RESET}\n"
}

function show_help() {
    print_banner
    echo "Usage: nexo-cli <command> [arguments]"
    echo ""
    echo "Commands:"
    echo "  boost             Engage Extreme Gaming & Low-Latency Hardware Boost"
    echo "  update            Synchronize Pacman, BlackArch, and Flatpak packages"
    echo "  stealth [on|off]  Toggle Tor transparent proxy, nftables killswitch, and MAC cycling"
    echo "  clean             Flush package caches, orphan dependencies, and wine temp prefixes"
    echo "  backup            Trigger an immediate timestamped Btrfs system snapshot"
    echo "  doctor            Audit GPU drivers, firewall, IP/DNS leaks, and system health"
    echo "  profile-toggle    Cycle between Standard, Gaming, and Stealth operational profiles"
    echo "  tor-status-badge  Output formatted status string for status bar integration"
    echo ""
}

# ------------------------------------------------------------------------------
# 0. Boost Subsystem (Ultra Gaming & Zero-Latency)
# ------------------------------------------------------------------------------
function do_boost() {
    print_banner
    echo -e "${YELLOW}[!] Engaging NexoOS Ultra Gaming & Low-Latency Boost...${RESET}"

    # 1. CPU Scaling Governor to Performance
    if command -v cpupower >/dev/null 2>&1; then
        echo -e "${CYAN}[*] Setting CPU governor to 'performance'...${RESET}"
        sudo cpupower frequency-set -g performance || true
    fi

    # 2. Hyprland Direct Scanout & Tearing bypass
    if command -v hyprctl >/dev/null 2>&1; then
        echo -e "${CYAN}[*] Enabling compositor direct scanout and esports tearing...${RESET}"
        hyprctl keyword render:direct_scanout true || true
        hyprctl keyword general:allow_tearing true || true
    fi

    # 3. GPU Power Management
    for card in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
        if [[ -f "${card}" ]]; then
            echo "high" | sudo tee "${card}" >/dev/null || true
        fi
    done

    # 4. Drop memory caches
    sync
    echo 3 | sudo tee /proc/sys/vm/drop_caches >/dev/null || true

    echo "Gaming" > /tmp/nexo-profile
    echo -e "${GREEN}[✓] ULTRA BOOST ACTIVE: CPU at maximum frequency, direct GPU scanout, zero lag!${RESET}"
}

# ------------------------------------------------------------------------------
# 1. Update Subsystem
# ------------------------------------------------------------------------------
function do_update() {
    print_banner
    echo -e "${GREEN}[*] Initiating comprehensive system repository synchronization...${RESET}"
    
    echo -e "${CYAN}[*] Synchronizing Pacman and BlackArch mirrors...${RESET}"
    sudo pacman -Syu --noconfirm

    if command -v flatpak >/dev/null 2>&1; then
        echo -e "${CYAN}[*] Updating Flatpak runtimes and applications...${RESET}"
        flatpak update -y || true
    fi

    echo -e "${GREEN}[✓] System update completed successfully!${RESET}"
}

# ------------------------------------------------------------------------------
# 2. Stealth & Anonymity Subsystem
# ------------------------------------------------------------------------------
function do_stealth() {
    local action="${1:-status}"

    case "${action}" in
        on)
            echo -e "${YELLOW}[!] Engaging NexoOS Stealth Perimeter Mode...${RESET}"
            
            sudo systemctl start tor.service
            
            echo -e "${CYAN}[*] Randomizing network interface MAC addresses...${RESET}"
            for iface in $(ip -o link show | awk -F': ' '{print $2}' | grep -Ev 'lo|veth|docker|tun'); do
                sudo ip link set "${iface}" down || true
                sudo macchanger -r "${iface}" || true
                sudo ip link set "${iface}" up || true
            done
            
            /usr/bin/nexo-killswitch on
            echo "Stealth" > /tmp/nexo-profile
            echo -e "${GREEN}[✓] Stealth mode ACTIVE. Egress traffic locked to Tor/VPN.${RESET}"
            ;;
        off)
            echo -e "${YELLOW}[*] Disengaging Stealth Mode... Returning to Standard profile.${RESET}"
            /usr/bin/nexo-killswitch off
            echo "Standard" > /tmp/nexo-profile
            echo -e "${GREEN}[✓] Standard networking restored.${RESET}"
            ;;
        status|*)
            if [[ -f /tmp/nexo-killswitch-active ]]; then
                echo -e "Stealth Status: ${GREEN}ACTIVE (Killswitch Engaged)${RESET}"
            else
                echo -e "Stealth Status: ${RED}INACTIVE (Standard Egress)${RESET}"
            fi
            ;;
    esac
}

# ------------------------------------------------------------------------------
# 3. Clean & Maintenance Subsystem
# ------------------------------------------------------------------------------
function do_clean() {
    print_banner
    echo -e "${CYAN}[*] Flushing pacman package cache...${RESET}"
    sudo pacman -Sc --noconfirm

    echo -e "${CYAN}[*] Removing orphaned packages...${RESET}"
    local orphans
    orphans=$(pacman -Qtdq 2>/dev/null || true)
    if [[ -n "${orphans}" ]]; then
        sudo pacman -Rns --noconfirm ${orphans}
    else
        echo "No orphaned packages found."
    fi

    echo -e "${CYAN}[*] Purging systemd journals older than 2 days...${RESET}"
    sudo journalctl --vacuum-time=2d

    echo -e "${CYAN}[*] Purging user cache (~/.cache)...${RESET}"
    rm -rf ~/.cache/* 2>/dev/null || true

    echo -e "${GREEN}[✓] System maintenance cleanup complete!${RESET}"
}

# ------------------------------------------------------------------------------
# 4. Btrfs Snapshot Backup Subsystem
# ------------------------------------------------------------------------------
function do_backup() {
    print_banner
    local stamp
    stamp="$(date +%Y%m%d_%H%M%S)"
    local snap_desc="nexo_manual_snapshot_${stamp}"

    echo -e "${CYAN}[*] Initiating timestamped Btrfs system snapshot [${stamp}]...${RESET}"

    if command -v snapper >/dev/null 2>&1; then
        sudo snapper -c root create -d "${snap_desc}"
        echo -e "${GREEN}[✓] Snapper root snapshot created: ${snap_desc}${RESET}"
    elif [[ -d /.snapshots ]]; then
        sudo btrfs subvolume snapshot / "/.snapshots/@_${stamp}"
        echo -e "${GREEN}[✓] Btrfs raw snapshot created: /.snapshots/@_${stamp}${RESET}"
    else
        echo -e "${RED}[ERROR] Neither Snapper nor /.snapshots found on current filesystem.${RESET}"
        exit 1
    fi
}

# ------------------------------------------------------------------------------
# 5. Doctor & Integrity Audit Subsystem
# ------------------------------------------------------------------------------
function do_doctor() {
    print_banner
    echo -e "${CYAN}=== NexoOS System Diagnostic & Integrity Audit ===${RESET}\n"

    echo -n "Active Kernel: "
    uname -r
    
    echo -n "GPU Acceleration: "
    if lspci | grep -Ei 'vga|3d' | grep -qi 'nvidia'; then
        echo -e "${GREEN}NVIDIA Dedicated Graphics Detected${RESET}"
    elif lspci | grep -Ei 'vga|3d' | grep -qi 'amd|radeon'; then
        echo -e "${GREEN}AMD Radeon Graphics (AMDGPU) Active${RESET}"
    elif lspci | grep -Ei 'vga|3d' | grep -qi 'intel'; then
        echo -e "${GREEN}Intel Graphics Active${RESET}"
    else
        echo -e "${YELLOW}Standard/Virtual Graphics Adapter${RESET}"
    fi

    echo -n "External IP: "
    curl -s --max-time 4 https://api.ipify.org || echo "Offline / Connection Blocked"
    echo ""

    echo -n "Tor Transparent Proxy Status: "
    if curl -s --socks5 127.0.0.1:9050 https://check.torproject.org | grep -qi "Congratulations"; then
        echo -e "${GREEN}SECURE (Routing through Tor Network)${RESET}"
    else
        echo -e "${YELLOW}Standard Direct Connection (Not Tor)${RESET}"
    fi

    echo -n "Firewall / Killswitch State: "
    if sudo nft list ruleset | grep -qi "policy drop"; then
        echo -e "${GREEN}HARDENED (Egress filter enforcing)${RESET}"
    else
        echo -e "${YELLOW}Standard Filter Ruleset${RESET}"
    fi

    echo -n "Root Filesystem Type: "
    findmnt -n -o FSTYPE /
    
    echo -e "\n${GREEN}[✓] Diagnostic inspection concluded.${RESET}"
}

# Helpers
function do_tor_badge() {
    if systemctl is-active --quiet tor.service && [[ -f /tmp/nexo-killswitch-active ]]; then
        echo "󰖂 TOR ACTIVE"
    else
        echo "󰖂 TOR OFF"
    fi
}

function do_profile_toggle() {
    local current
    current=$(cat /tmp/nexo-profile 2>/dev/null || echo "Standard")

    case "${current}" in
        Standard)
            do_boost
            notify-send "NexoOS Profile" "Switched to GAMING Mode (Ultra Boost Active)" -i preferences-system-performance
            ;;
        Gaming)
            do_stealth on
            notify-send "NexoOS Profile" "Switched to STEALTH Mode (Tor & Killswitch Active)" -i security-high
            ;;
        Stealth|*)
            do_stealth off
            notify-send "NexoOS Profile" "Switched to STANDARD Mode" -i preferences-desktop-theme
            ;;
    esac
}

CMD="${1:-help}"
shift || true

case "${CMD}" in
    boost)            do_boost "$@" ;;
    update)           do_update "$@" ;;
    stealth)          do_stealth "$@" ;;
    clean)            do_clean "$@" ;;
    backup)           do_backup "$@" ;;
    doctor)           do_doctor "$@" ;;
    tor-status-badge) do_tor_badge "$@" ;;
    profile-toggle)   do_profile_toggle "$@" ;;
    stealth-toggle)   
        if [[ -f /tmp/nexo-killswitch-active ]]; then
            do_stealth off
        else
            do_stealth on
        fi
        ;;
    help|--help|-h)   show_help ;;
    *)
        echo -e "${RED}[ERROR] Unknown command: ${CMD}${RESET}"
        show_help
        exit 1
        ;;
esac
