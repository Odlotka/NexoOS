/* ==============================================================================
   NexoOS Calamares Installer Frosted Glass Dark Theme
   ============================================================================== */

QWidget {
    background-color: #0b0f19;
    color: #e2e8f0;
    font-family: "JetBrainsMono Nerd Font", "Noto Sans", sans-serif;
    font-size: 13px;
}

QDialog {
    background-color: #0b0f19;
}

QLabel {
    color: #cbd5e1;
}

QLabel#headerText {
    font-size: 18px;
    font-weight: bold;
    color: #00f0ff;
}

/* Sidebar Styling */
#sidebarApp {
    background-color: #070a10;
    border-right: 1px solid rgba(0, 240, 255, 0.15);
    min-width: 200px;
}

#sidebarApp QLabel {
    color: #64748b;
    padding: 8px 16px;
    font-size: 14px;
}

#sidebarApp QLabel[selected=true] {
    color: #00f0ff;
    font-weight: bold;
    background-color: rgba(0, 240, 255, 0.08);
    border-left: 3px solid #00f0ff;
}

/* PushButtons with Cyan Glowing Hover */
QPushButton {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(0, 240, 255, 0.3);
    border-radius: 8px;
    padding: 8px 20px;
    color: #f8fafc;
    font-weight: bold;
}

QPushButton:hover {
    background-color: rgba(0, 240, 255, 0.2);
    border: 1px solid #00f0ff;
}

QPushButton:pressed {
    background-color: rgba(0, 240, 255, 0.35);
}

QPushButton:disabled {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    color: #475569;
}

/* Inputs & ComboBoxes */
QLineEdit, QComboBox, QSpinBox {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 6px 12px;
    color: #ffffff;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #00f0ff;
}

/* Progress Bars */
QProgressBar {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    text-align: center;
    color: #ffffff;
    height: 18px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7928ca, stop:1 #00f0ff);
    border-radius: 5px;
}
